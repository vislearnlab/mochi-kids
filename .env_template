ENVIRONMENT=development
# Set BASE_PATH if hosting behind nginx with a path prefix (e.g. "mochi-kids").
# Leave unset for local development; the app is then served at /.
BASE_PATH=

# MongoDB connection — point at the lab's vislearnlab Atlas cluster.
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net
DATABASE=mochi_kids
COLLECTION=trials

# Production HTTPS — point at a folder containing ssl_key.pem and ssl_cert.pem.
# Only used when ENVIRONMENT=production.
CREDENTIALS_PATH=credentials/

PORT=9000
